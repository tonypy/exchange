<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="off" monitorInterval="30">
    <CustomLevels>
        <CustomLevel name="myLevel" intLevel="99"/>
    </CustomLevels>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8"
                           pattern="%d{HH:mm:ss.SSS} [%traceId] [%thread] %-5level %logger{36} - %msg%n"/>
            <filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT"/>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT"/>
            </filters>
        </Console>

        <RollingRandomAccessFile name="startup" fileName="${env:LOG_HOME}/startup.log"
                                 filePattern="${env:LOG_HOME}/startup.log.%d{yyyy-MM-dd}">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="METRICS_LOG" fileName="${env:LOG_HOME}/common_metrics.log"
                                 filePattern="${env:LOG_HOME}/common_metrics.log.%d{yyyy-MM-dd}">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="WARN_LOG" fileName="${env:LOG_HOME}/common_warn.log"
                                 filePattern="${env:LOG_HOME}/common_warn.log.%d{yyyy-MM-dd}">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT"/>
            </filters>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="ACCOUNT_WARN_LOG" fileName="${env:LOG_HOME}/account_warn_log.log"
                                 filePattern="${env:LOG_HOME}/account_warn_log.log.%d{yyyy-MM-dd}-%i">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5">
                <Delete basePath="${env:LOG_HOME}" maxDepth="2">
                    <IfFileName glob="*account_warn_log.log*"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
            <filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT"/>
            </filters>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="EXCHANGE_WARN_LOG" fileName="${env:LOG_HOME}/exchange_warn_log.log"
                                 filePattern="${env:LOG_HOME}/exchange_warn_log.log.%d{yyyy-MM-dd}-%i">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="5">
                <Delete basePath="${env:LOG_HOME}" maxDepth="2">
                    <IfFileName glob="*exchange_warn_log.log*"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
            <filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT"/>
            </filters>
        </RollingRandomAccessFile>
        <RollingRandomAccessFile name="BIZ_WARN_LOG" fileName="${env:LOG_HOME}/biz_warn_log.log"
                                 filePattern="${env:LOG_HOME}/biz_warn_log.log.%d{yyyy-MM-dd}-%i">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="50">
                <Delete basePath="${env:LOG_HOME}" maxDepth="2">
                    <IfFileName glob="*biz_warn_log.log*"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
            <filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT"/>
            </filters>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="ERROR_LOG" fileName="${env:LOG_HOME}/common_error.log"
                                 filePattern="${env:LOG_HOME}/common_error.log.%d{yyyy-MM-dd}-%i">
            <PatternLayout charset="UTF-8"
                           pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [%traceId] %level [%c:%line] - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="50">
                <Delete basePath="${env:LOG_HOME}" maxDepth="2">
                    <IfFileName glob="*common_error.log.*"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
            <filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT"/>
            </filters>
        </RollingRandomAccessFile>
    </Appenders>

    <Loggers>
        <AsyncLogger name="STARTUP" level="INFO">
            <AppenderRef ref="startup"/>
        </AsyncLogger>

        <AsyncLogger name="metrics" level="WARN">
            <AppenderRef ref="METRICS_LOG"/>
        </AsyncLogger>

        <AsyncLogger name="ACCOUNT_WARN_LOG" level="WARN">
            <AppenderRef ref="ACCOUNT_WARN_LOG"/>
        </AsyncLogger>

        <AsyncLogger name="EXCHANGE_WARN_LOG" level="WARN">
            <AppenderRef ref="EXCHANGE_WARN_LOG"/>
        </AsyncLogger>

        <AsyncLogger name="BIZ_WARN_LOG" level="WARN">
            <AppenderRef ref="BIZ_WARN_LOG"/>
        </AsyncLogger>

        <AsyncRoot level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ERROR_LOG"/>
            <AppenderRef ref="WARN_LOG"/>
        </AsyncRoot>

    </Loggers>
</Configuration>
